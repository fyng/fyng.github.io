{
  "name": "ga-revideo",
  "private": true,
  "type": "module",
  "description": "Revideo (Motion Canvas API) version of the Precision Safety abstract, for comparison with the SVG kit.",
  "scripts": {
    "icons": "node -e \"const f=require('fs');f.writeFileSync('src/icons.ts',f.readFileSync('../kit/icons.js','utf8').replace('window.GA_ICONS =','export const GA_ICONS: Record<string,string> ='))\"",
    "render": "npm run icons && DISABLE_TELEMETRY=true node render.mjs"
  },
  "dependencies": {
    "@revideo/2d": "0.11.0",
    "@revideo/core": "0.11.0",
    "@revideo/ffmpeg": "0.11.0",
    "@revideo/renderer": "0.11.0",
    "@revideo/ui": "0.11.0",
    "@revideo/vite-plugin": "0.11.0"
  }
}
