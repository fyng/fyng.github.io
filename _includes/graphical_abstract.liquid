{%- comment -%}
  Graphical abstract (Lamina figure) in a publication's preview slot.
  The slot shows the static poster, scaled to the column. The animation opens
  in an expanded view: while hovering on pointer devices, and on click or tap
  everywhere (a dismissable overlay sized to fit the viewport). Behaviour lives
  in assets/js/graphical-abstract.js.
  Assets: assets/img/graphical_abstracts/<slug>.png, -thumb.png, .mp4, .webm,
  copied from graphical_abstracts/out/ by graphical_abstracts/publish.sh.
  Styles and script are linked once per page with a per-build version, so a
  deploy never pairs new markup with cached old styles or behaviour.
  Params: slug (required), title (for alt text), thumb (optional: a
  publication_preview image to keep as the thumbnail instead of <slug>-thumb.png).
{%- endcomment -%}
{% unless ga_assets_included %}
  {% assign ga_assets_included = true %}
  {% assign ga_v = site.time | date: '%s' %}
  <link rel="stylesheet" href="{{ '/assets/css/graphical-abstract.css' | relative_url }}?v={{ ga_v }}">
  <script defer src="{{ '/assets/js/graphical-abstract.js' | relative_url }}?v={{ ga_v }}"></script>
{% endunless %}
{% assign ga_base = '/assets/img/graphical_abstracts/' | append: include.slug | relative_url %}
{% capture ga_alt %}Graphical abstract: {{ include.title }}{% endcapture %}
<button
  type="button"
  class="ga-thumb"
  style="width: 100%; padding: 0; border: 0; background: none"
  data-ga
  data-slug="{{ include.slug }}"
  data-poster="{{ ga_base }}.png"
  data-sources="{{ ga_base }}.mp4 video/mp4, {{ ga_base }}.webm video/webm"
  data-alt="{{ ga_alt | escape }}"
  aria-label="Play {{ ga_alt | escape }}"
>
  {% if include.thumb %}
    {% assign ga_thumb = '/assets/img/publication_preview/' | append: include.thumb | relative_url %}
  {% else %}
    {% assign ga_thumb = ga_base | append: '-thumb.png' %}
  {% endif %}
  <img
    class="preview z-depth-1 rounded"
    style="width: 100%; height: auto"
    src="{{ ga_thumb }}"
    alt="{{ ga_alt | escape }}"
    {% unless include.thumb %}width="640" height="360"{% endunless %}
    loading="lazy"
    decoding="async"
  >
</button>
