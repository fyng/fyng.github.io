{%- comment -%}
  Graphical abstract (Lamina figure) in a publication's preview slot.
  The slot shows the static poster, scaled to the column. The animation opens
  in an expanded view: while hovering on pointer devices, and on click or tap
  everywhere (a dismissable overlay sized to fit the viewport). Behaviour lives
  in assets/js/graphical-abstract.js.
  Assets: assets/img/graphical_abstracts/<slug>.png, -thumb.png, .mp4, .webm,
  copied from graphical_abstracts/out/ by graphical_abstracts/publish.sh.
  Params: slug (required), title (for alt text).
{%- endcomment -%}
{% assign ga_base = '/assets/img/graphical_abstracts/' | append: include.slug | relative_url %}
{% capture ga_alt %}Graphical abstract: {{ include.title }}{% endcapture %}
<button
  type="button"
  class="ga-thumb"
  data-ga
  data-slug="{{ include.slug }}"
  data-poster="{{ ga_base }}.png"
  data-sources="{{ ga_base }}.mp4 video/mp4, {{ ga_base }}.webm video/webm"
  data-alt="{{ ga_alt | escape }}"
  aria-label="Play {{ ga_alt | escape }}"
>
  <img
    class="preview z-depth-1 rounded"
    src="{{ ga_base }}-thumb.png"
    alt="{{ ga_alt | escape }}"
    width="640"
    height="360"
    loading="lazy"
    decoding="async"
  >
</button>
{% unless ga_script_included %}
  {% assign ga_script_included = true %}
  <script defer src="{{ '/assets/js/graphical-abstract.js' | relative_url }}"></script>
{% endunless %}
