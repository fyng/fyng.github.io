{% comment %}
  Local override of al_folio_cv cv/publications.liquid.
  Renders RenderCV PublicationEntry fields (title, authors, journal, date, doi/url)
  so the same _data/cv.yml drives both the web CV and the RenderCV PDF.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    {% assign pub_url = entry.url %}
    {% if entry.doi %}{% assign pub_url = 'https://doi.org/' | append: entry.doi %}{% endif %}
    {% capture pub_date %}{% if entry.releaseDate %}{{ entry.releaseDate }}{% elsif entry.date %}{{ entry.date }}{% endif %}{% endcapture %}
    {% assign pub_date = pub_date | strip %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 col-sm-2 col-md-2 text-center">
          {% if pub_date != '' %}
            <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">
              {{- pub_date | split: '-' | first -}}
            </span>
          {% endif %}
        </div>
        <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {% if pub_url %}<a href="{{ pub_url }}">{{ entry.title | default: entry.name }}</a>{% else %}{{ entry.title | default: entry.name }}{% endif %}
          </h6>
          {% if entry.authors %}
            <p class="ml-1 ml-md-4 mb-1">{{ entry.authors | join: ', ' | markdownify | remove: '<p>' | remove: '</p>' }}</p>
          {% endif %}
          {% assign venue = entry.journal | default: entry.publisher %}
          {% if venue %}
            <p class="ml-1 ml-md-4 mb-0"><em>{{ venue | markdownify | remove: '<p>' | remove: '</p>' | strip }}</em></p>
          {% endif %}
          {% if entry.summary %}
            <p class="ml-1 ml-md-4">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
